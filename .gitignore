# ============================================
# Dev/test scripts (root level)
# (proper unit tests in tests/ are tracked)
#
# NOTE: the build and release toolchain does NOT belong in this section.
# container-build.sh, package-extension.sh and fresh-start-for-testing.sh
# were once filed here by mistake, which left a
# clone of this repository unable to build or release itself — build-release.sh
# is tracked but calls container-build.sh, which was not. Keep anything the
# documented release process in CLAUDE.md depends on OUT of this list.
# ============================================
test-*.sh
test-*.py
test_*.py
!tests/test_*.py
list-atspi-apps.py
mcp-screenshot-server.py
launch-gtk-inspector.sh
install-xdotool.sh
regenerate-autostart*.py
cleanup-docker-artifacts.sh
build-with-appimage-builder.sh
fresh-start*.sh
!fresh-start-for-testing.sh
fresh-test-env.sh

# ============================================
# AUR publishing clone
# ============================================
# aur-repo/ is a working clone of the real AUR package repository
# (ssh://aur@aur.archlinux.org/talktype-appimage.git) used to push releases to
# Arch. It has its own .git, so committing it into this repository recorded it
# as a submodule with no .gitmodules — which made `git clone
# --recurse-submodules` fail and showed as a dead link on GitHub. The packaging
# sources that belong to this project live in aur/ and are tracked there.
aur-repo/
# The same for the package after the 0.15.0 rename
# (ssh://aur@aur.archlinux.org/tuxtalk-appimage.git).
aur-repo-tuxtalk/

