                              {"Access-Control-Allow-Origin", "*"},
                              {"Access-Control-Allow-Headers", "content-type, authorization"}});
 
+    // TuxTalk: with WHISPER_API_KEY set, every request but the health check
+    // needs "Authorization: Bearer <key>", static files included. Without
+    // it, another user's programs, or a web page posting to 127.0.0.1, could
+    // send audio or reach the other routes. The key comes from the
+    // environment, which only this user can read, not the command line,
+    // which every user can. This runs before any body is read, so a request
+    // without the key never gets one read: the health check is let through
+    // only as a GET or HEAD with no body.
+    const char * api_key_env = std::getenv("WHISPER_API_KEY");
+    const std::string api_key = api_key_env ? api_key_env : "";
+    if (!api_key.empty()) {
+        const std::string health_path = sparams.request_path + "/health";
+        svr->set_pre_routing_handler([api_key, health_path](const Request & req, Response & res) {
+            if (req.path == health_path && (req.method == "GET" || req.method == "HEAD") &&
+                !httplib::detail::expect_content(req)) {
+                return Server::HandlerResponse::Unhandled;
+            }
+            const std::string expected = "Bearer " + api_key;
+            const std::string given = req.get_header_value("Authorization");
+            // Every byte compared, so the time taken doesn't tell how much matched.
+            unsigned char differs = given.size() != expected.size();
+            for (size_t i = 0; i < given.size() && i < expected.size(); i++) {
+                differs |= given[i] ^ expected[i];
+            }
+            if (differs == 0) {
+                return Server::HandlerResponse::Unhandled;
+            }
+            res.status = 401;
+            res.set_content("{\"error\":\"invalid API key\"}", "application/json");
+            return Server::HandlerResponse::Handled;
+        });
+    }
